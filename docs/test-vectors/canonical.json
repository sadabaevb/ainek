{
  "_about": "Canonical JSON test vectors shared by packages/proof (TS) and the Rust side (contract entry_hash, policy job decision bytes). Every implementation must reproduce `canonical` byte for byte and `sha256` of its UTF-8 bytes. Regenerate: tmp script in Bektur's session; cross-checked with Python json.dumps(sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).",
  "rules": [
    "object keys sorted by Unicode code point (= UTF-8 byte order = Rust BTreeMap<String,_>)",
    "no whitespace",
    "strings escaped as JSON.stringify/serde_json: \" \\ \\b \\f \\n \\r \\t, other control chars as lowercase \\u00xx; \"/\" and non-ASCII unescaped",
    "numbers: safe integers only (|n| <= 2^53-1); floats and bigger numbers are rejected; U64/U128 travel as decimal strings",
    "arrays keep order; undefined in an array becomes null; object members with undefined value are omitted",
    "only plain objects, arrays, strings, numbers, booleans, null"
  ],
  "rejected": [
    {
      "example": "{\"x\":1.5}",
      "reason": "non-integer number"
    },
    {
      "example": "{\"x\":1e21}",
      "reason": "outside safe integer range"
    },
    {
      "example": "{\"x\":NaN}",
      "reason": "not finite"
    },
    {
      "example": "{\"x\":123n}",
      "reason": "bigint (encode as string)"
    },
    {
      "example": "{\"x\":new Date()}",
      "reason": "not a plain object"
    }
  ],
