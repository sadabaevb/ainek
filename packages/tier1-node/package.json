{
  "name": "@ainek/tier1-node",
  "version": "0.1.0",
  "private": true,
  "description": "Ainek Tier-1 sequence from Node (attest, fail-closed log check, E2EE request, signature, proof) for demo:live, demo:metrics and the agent service; without a key, up to the send, for demo:attest",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./dcap": {
      "types": "./src/dcap.ts",
      "default": "./src/dcap.ts"
    },
    "./hop": {
      "types": "./src/hop.ts",
      "default": "./src/hop.ts"
    }
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ainek/proof": "workspace:*",
    "@nearai/inference-sdk": "0.3.0",
    "@phala/dcap-qvl": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
