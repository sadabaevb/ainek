{
  "name": "verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Ainek verifier daemon: re-attests NEAR AI models with a fresh nonce and appends their signing keys to the public key log (SPEC §3.2)",
  "type": "module",
  "bin": {
    "ainek-verify": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "dry-run": "node src/main.ts --dry-run",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ainek/proof": "workspace:*",
    "@nearai/inference-sdk": "0.3.0",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
