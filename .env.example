# NEAR AI Cloud — workspace API key with a spend limit (cloud.near.ai → API Keys). Server-side only.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash

# NEAR testnet
NEAR_NETWORK=testnet
# NEAR_RPC_URL=   # optional; the default (FastNear for NEAR_NETWORK) lives in packages/proof/src/config.ts, one place for every app
AINEK_CONTRACT=ainek-log-dastan.testnet
AINEK_TOKEN=token.ainek-dev-dastan.testnet
# Where the web client reads the key log from: "contract" = view calls to AINEK_CONTRACT over NEAR_RPC_URL (default),
# "sample" = the recorded entry in docs/samples/key-entry.sample.json (offline)
AINEK_LOG_SOURCE=contract
# Client-side trust policy (SPEC §7.1): which verifiers count, and how many must agree (1 demo / 2 prod).
# This is what the site offers by default; a visitor can replace it on /log, in their own browser.
AINEK_TRUSTED_VERIFIERS=ainek-dev-dastan.testnet
AINEK_QUORUM=1
# TCB statuses the client accepts for gateway and model quotes (comma-separated; SDK default also allows OutOfDate,TDRelaunchAdvised)
AINEK_ACCEPTED_TCB=UpToDate
# Incognito-tier model for the non-TEE route demo (SPEC §3.9); gateway-signed only
NEARAI_INCOGNITO_MODEL=anthropic/claude-haiku-5-5

# Verifier daemon (one per machine; v1 / v2)
VERIFIER_ACCOUNT_ID=v1.ainek.testnet
VERIFIER_PRIVATE_KEY=ed25519:...
VERIFIER_MODELS=z-ai/glm-5.3-flash,deepseek-ai/DeepSeek-V4.1-Flash-1017
VERIFIER_INTERVAL_MIN=15
# Where the daemon keeps full attestation reports (<report_hash>.json); default services/verifier/data/reports
# VERIFIER_DATA_DIR=/var/lib/ainek/reports

# Agent service (Tier 2) — function-call key scoped to commit_proof and propose_action only. The agent account prepays
# its commits and action records once with deposit_storage (full-access key, SPEC §4.2).
AGENT_ACCOUNT_ID=agent.ainek-dev-dastan.testnet
AGENT_FC_PRIVATE_KEY=ed25519:...
OWNER_ACCOUNT_ID=ainek-log-dastan.testnet
# Where proofs and their salts are kept (default services/agent/data/proofs, not in git)
# AGENT_DATA_DIR=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Stop button (`pnpm demo:stop`): these go in .env.owner on the owner's machine, never in .env on the agent's server, together
# with AGENT_ACCOUNT_ID, OWNER_ACCOUNT_ID and AINEK_CONTRACT if that machine has no .env. The agent refuses to start if it sees
# either private key: it must not be able to approve for itself or undo its own stop.
# AGENT_ADMIN_PRIVATE_KEY=ed25519:...   full-access key of the agent account (a function-call key cannot delete keys)
# OWNER_PRIVATE_KEY=ed25519:...         the contract owner's key (pause_agent is owner-only)
# AGENT_FC_PUBLIC_KEY=ed25519:...       the function-call key to delete

# OutLayer (Tier 2)
OUTLAYER_API_URL=https://testnet-api.outlayer.ai
OUTLAYER_PAYMENT_KEY=owner:nonce:secret
OUTLAYER_PROJECT=ainek-dev-dastan.testnet/policy
OUTLAYER_WASM_HASH=8041305f57d4f5668ee5d40f0f461b3df3fd22145f3e90c704a0204625f2d2eb

