{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "description": "Ainek replay demo: re-verifies recorded NEAR AI evidence offline and prints the proof card",
  "type": "module",
  "scripts": {
    "replay": "node src/replay.ts",
    "tamper": "node src/replay.ts --tamper",
    "live": "node src/live.ts",
    "record": "node scripts/record-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "check-contract": "node scripts/check-contract.mjs",
    "check-agent": "node scripts/check-agent.mjs",
    "metrics": "node src/metrics.ts",
    "policy": "node src/policy-run.ts",
    "record-policy-runs": "node scripts/record-policy-runs.mjs"
  },
  "dependencies": {
    "@ainek/proof": "workspace:*",
    "@ainek/tier1-node": "workspace:*",
    "@nearai/inference-sdk": "0.3.0",
    "@phala/dcap-qvl": "0.7.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
